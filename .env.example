# Mandate repo-root environment (example) — used by Foundry / contract scripts.
# NOT required to run the live web demo (see DEMO.md). Copy to .env.local and fill in
# real values. Do NOT commit .env.local. Replace every <placeholder>.
#
# SECURITY: PRIVATE_KEY, PRICE_SIGNER_PK, SESSION_KEY, and SESSION_KEY_PRIVATE_KEY are
# private keys. Never commit them and never place them in any frontend (NEXT_PUBLIC_)
# variable.

# RPC + network
RPC_URL=<https-rpc-url-for-chain-46630>
CHAIN_ID=46630
EXPLORER_URL=

# Deployer / owner
PRIVATE_KEY=<0x-deployer-private-key>
OWNER=<owner-address>

# Price signer (private key) — keep distinct from deployer/session keys.
PRICE_SIGNER_PK=<0x-price-signer-private-key>

# Session key (address and matching private key)
SESSION_KEY=<session-key-address>
SESSION_KEY_PRIVATE_KEY=<0x-session-key-private-key>

# Max accepted price staleness (seconds)
PRICE_MAX_STALENESS=<seconds>
