# Mandate price signer environment (example).
# The signer reads process.env directly and does NOT auto-load a .env file. Either
# export these before `npm start`, pass them inline on the command line, or load this
# file with your own tooling. Replace every <placeholder> — these are NOT real values.
#
# SECURITY:
#   - PRICE_SIGNER_KEY is a private key. Never commit it. It must be DISTINCT from the
#     deployer and session keys (the signer refuses to start otherwise) and must match
#     deployment.priceSigner.

# Required: EIP-712 price signer private key (0x-prefixed hex).
PRICE_SIGNER_KEY=<0x-price-signer-private-key>

# Recommended: auto-resolve oracle address, USDG address, chainId, and the expected
# price signer from the committed deployment descriptor.
MANDATE_DEPLOYMENT_PATH=../deployments/46630.json

# --- Optional overrides (defaults shown) ---
# Used only if MANDATE_DEPLOYMENT_PATH is not set, or to override the descriptor.
# ORACLE_ADDRESS=<signed-demo-price-feed-address>
# USDG_ADDRESS=<usdg-token-address>
# CHAIN_ID=46630
# PORT=8787
# SIGNER_HOST=127.0.0.1
# PRICE_TTL_SECONDS=3600
# DEFAULT_PRICE_USDG_1E18=1000000000000000000
# PRICE_MAP_JSON={"<asset-address>":"<price-usdg-1e18>"}
