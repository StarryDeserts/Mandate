# Mandate web app environment (example).
# Copy to web/.env.local and fill in real values. Do NOT commit web/.env.local.
#
# Public contract values come from deployments/46630.json (the committed source of
# truth). Replace every <placeholder> below — these are NOT real values.
#
# SECURITY:
#   - Anything prefixed NEXT_PUBLIC_ is exposed in the browser bundle. Only put
#     public addresses / URLs there. NEVER put a private key in a NEXT_PUBLIC_ var.
#   - PRICE_SIGNER_KEY and MANDATE_SESSION_KEY_PRIVATE_KEY are server-side only.
#     Never prefix them with NEXT_PUBLIC_ and never commit them.

# --- Public network / contract config (safe to expose) ---
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_DEPLOYER=<deployer-address>
NEXT_PUBLIC_OWNER=<owner-address>
NEXT_PUBLIC_PRICE_SIGNER=<price-signer-address>
NEXT_PUBLIC_USDG_ADDRESS=<usdg-token-address>
NEXT_PUBLIC_TSLA_ADDRESS=<tsla-token-address>
NEXT_PUBLIC_AMD_ADDRESS=<amd-token-address>
NEXT_PUBLIC_AMM_ADDRESS=<mock-amm-address>
NEXT_PUBLIC_ADAPTER_ADDRESS=<approved-swap-adapter-address>
NEXT_PUBLIC_PRICE_FEED_ADDRESS=<signed-demo-price-feed-address>
NEXT_PUBLIC_MANDATE_ACCOUNT_ADDRESS=<mandate-account-address>

# Public RPC endpoint for Robinhood Chain testnet (chainId 46630).
NEXT_PUBLIC_ROBINHOOD_RPC_URL=<https-rpc-url-for-chain-46630>

# Price endpoint used by the demo agent. Use /api/demo-price on Vercel so no
# separate price signer process is required. For local signer development, use
# http://127.0.0.1:8787/price instead.
NEXT_PUBLIC_MANDATE_PRICE_URL=/api/demo-price

# --- Server-side ONLY (NEVER NEXT_PUBLIC_, NEVER commit) ---
# Price signer key used by /api/demo-price. Must derive to deployment.priceSigner
# in deployments/46630.json.
PRICE_SIGNER_KEY=<0x-price-signer-private-key>

# Session key used by the demo-agent relayer route. Must correspond to
# deployment.sessionKey in deployments/46630.json.
MANDATE_SESSION_KEY_PRIVATE_KEY=<0x-session-key-private-key>
